{
  "name": "mocha-reporter-ui",
  "version": "0.6.1",
  "description": "Mocha unit test reporter",
  "main": "server.js",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "export": "next export",
    "start": "node server.js",
    "production": "npm run build && NODE_ENV=production npm start",
    "lint": "eslint \"**/*.{js,jsx}\" --fix",
    "test": "mocha",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,md,json}\""
  },
  "keywords": [
    "mocha",
    "test"
  ],
  "author": "Hui Zhou",
  "dependencies": {
    "axios": "^1.16.1",
    "classnames": "^2.5.1",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "nan": "^2.27.0",
    "next": "^16.2.6",
    "node-gyp": "^12.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^15.0.0",
    "react-redux": "^9.3.0",
    "reactstrap": "^9.2.3",
    "redux": "^5.0.0",
    "redux-logger": "^3.0.6",
    "redux-promise-middleware": "^6.2.0",
    "redux-thunk": "^3.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "eslint": "^9.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "mocha": "^10.0",
    "mocha-jenkins-reporter": "^0.4.8",
    "prettier": "^3.8.3",
    "@redux-devtools/extension": "^4.0.0"
  },
  "overrides": {
    "diff": "9.0.0",
    "postcss": "8.5.15",
    "serialize-javascript": "7.0.5"
  },
  "repository": "https://github.com/yihaozhadan/mocha-reporter-ui",
  "license": "MIT"
}
